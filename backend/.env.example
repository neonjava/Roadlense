# Backend Environment Variables

# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=roadfix

# AI Analysis (Optional - app works without it, but won't provide AI analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CORS Configuration
# For development: Leave empty to allow all origins
# For production: Set specific origins separated by commas
# Examples: http://localhost:3000,http://localhost:8100,capacitor://localhost
ALLOWED_ORIGINS=

# Android Development Notes:
# - Make sure to run backend with --host 0.0.0.0 to accept connections from network
# - Command: uvicorn server:app --reload --host 0.0.0.0 --port 8000
# - Allow port 8000 in your firewall if needed
